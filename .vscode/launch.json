{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "gateway.main:create_app",
        "--reload",
        "--port",
        "8001"
      ],
      "jinja": true
    }
  ]
}